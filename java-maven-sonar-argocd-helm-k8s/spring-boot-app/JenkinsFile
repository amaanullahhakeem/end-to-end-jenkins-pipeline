pipeline {
agent any

environment {
    AWS_REGION = 'ap-south-1'
    ECR_REGISTRY = '743887468885.dkr.ecr.ap-south-1.amazonaws.com'
    ECR_REPOSITORY = 'production-eks-dev/spring-boot-app'
    IMAGE_TAG = "${BUILD_NUMBER}"
    APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
    MANIFEST_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests'
}

stages {

    stage('Checkout') {
        steps {
            git branch: 'main',
                url: 'https://github.com/amaanullahhakeem/end-to-end-jenkins-pipeline.git'
        }
    }

    stage('Build') {
        steps {
            dir("${APP_DIR}") {
                sh 'mvn clean package'
            }
        }
    }

    stage('Test') {
        steps {
            dir("${APP_DIR}") {
                sh 'mvn test'
            }
        }
    }

    stage('Sonarqube') {
        steps {
            dir("${APP_DIR}") {
                withSonarQubeEnv('sonarqube') {
                    sh 'mvn sonar:sonar'
                }
            }
        }
    }

    stage('Docker Build') {
        steps {
            dir("${APP_DIR}") {
                sh """
                    docker build \
                    -t ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG} .
                """
            }
        }
    }

    stage('Push to ECR') {
        steps {
            withCredentials([[
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-credentials'
            ]]) {
                sh """
                    aws sts get-caller-identity

                    aws ecr get-login-password \
                    --region ${AWS_REGION} | \
                    docker login \
                    --username AWS \
                    --password-stdin ${ECR_REGISTRY}

                    docker push \
                    ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}
                """
            }
        }
    }

    stage('Update Manifest') {
        steps {
            withCredentials([string(
                credentialsId: 'github-credentials',
                variable: 'GITHUB_TOKEN'
            )]) {
                sh """
                    sed -i "s|image:.*|image: ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}|" \
                    ${MANIFEST_DIR}/deployment.yml

                    git config user.name "Aman Ullah Hakeem"
                    git config user.email "aamaanullahhakeem@gmail.com"

                    git add ${MANIFEST_DIR}/deployment.yml

                    git commit -m "Update image to ${IMAGE_TAG}" || true

                    git push https://amaanullahhakeem:${GITHUB_TOKEN}@github.com/amaanullahhakeem/end-to-end-jenkins-pipeline.git HEAD:main
                """
            }
        }
    }
}

}

